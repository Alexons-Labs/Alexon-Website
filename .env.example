# Contact form delivery (app/api/contact/route.ts)
# Create .env.local locally or set these in your host's env panel.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxx

# Where enquiries land
CONTACT_TO=alexonlabs@gmail.com

# Sender — must be a domain verified in Resend, otherwise use:
# "Alexons <onboarding@resend.dev>" (and you will not receive replies to it).
RESEND_FROM="Alexons <hello@alexon.in>"